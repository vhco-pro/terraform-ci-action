#!/usr/bin/env bash
set -euo pipefail

workspace=$(git rev-parse --show-toplevel)
cd -- "$workspace"
scope=$(realpath -m -- "${TERRAFORM_CI_WORKING_DIRECTORY:-.}")
case "$scope" in
  "$workspace"|"$workspace"/*) ;;
  *) printf '%s\n' 'Terraform hook scope escapes the checkout.' >&2; exit 1 ;;
esac
relative=$(realpath --relative-to="$workspace" -- "$scope")
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
git diff --cached --name-only --no-renames --diff-filter=ACMT -z > "$scratch/staged"
paths=()
while IFS= read -r -d '' file; do
  case "$file" in
    *.tf|*.tfvars|*.tftest.hcl) ;;
    *.tofu|*.tofutest.hcl) [[ ${TERRAFORM_CI_ENGINE:-} == tofu ]] || continue ;;
    *) continue ;;
  esac
  if [[ $relative == . || $file == "$relative/"* ]]; then paths+=("$file"); fi
done < "$scratch/staged"
(( ${#paths[@]} )) || exit 0
check=$(realpath -e -- "${TERRAFORM_CI_CHECK:?Set TERRAFORM_CI_CHECK to the pinned check script.}")
printf '%s\0' "${paths[@]}" | git checkout-index --stdin -z --prefix="$scratch/tree/"
cd -- "$scratch/tree"
for file in "${paths[@]}"; do
  [[ ! -L $file ]] || { printf 'Staged Terraform symlink: %s\n' "$file" >&2; exit 1; }
  "$check" format "./$file"
done
